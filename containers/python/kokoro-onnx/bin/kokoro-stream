#!/bin/sh
""":"
# Redirect standard error (2) to dev/null to block ONNX initialization logs
exec "$(dirname "$0")/../kokoro/.venv/bin/python3" "$0" "$@" 2>/dev/null
"""
import os
import sys
import pwd
import getopt
import asyncio
import subprocess

#=======================================================================
# 1. Suppress Environment Noise & Warnings
#=======================================================================
os.environ["ORT_LOGGING_LEVEL"] = "3"
sys.stderr = open(os.devnull, "w")

def get_username():
    try:
        return os.getlogin()
    except OSError:
        return pwd.getpwuid(os.getuid())[0]

USER = get_username()

#=======================================================================
# 2. Clean Imports
#=======================================================================
import onnxruntime as ort
from kokoro_onnx import Kokoro

#=======================================================================
# 3. Help Menu Definition
#=======================================================================
def display_help():
    help_text = f"""
Usage: kokoro -f <input_text_file> [OPTIONS]

Options:
  -f <file>    Path to the input text file to read from (Required)
  -v <voice>   Specify the speaker voice variant
               Default: bm_lewis
  -h           Display this help usage screen

Available Voices Reference:
  https://huggingface.co/hexgrad/Kokoro-82M/blob/main/VOICES.md
"""
    print(help_text)
    sys.exit(0)

#=======================================================================
# 4. Argument Handling Engine (getopt)
#=======================================================================
def parse_arguments():
    try:
        opts, args = getopt.getopt(sys.argv[1:], "hf:v:")
    except getopt.GetoptError as err:
        print(f"Error: {err}")
        print(f"Run 'kokoro -h' for usage parameters.")
        sys.exit(2)

    input_file = None
    voice = "bm_lewis"

    for o, a in opts:
        if o == "-h":
            display_help()
        elif o == "-f":
            input_file = a
        elif o == "-v":
            voice = a

    if not input_file:
        print("Error: Input file (-f) is required.")
        print("Run 'kokoro -h' for usage parameters.")
        sys.exit(2)

    return input_file, voice

#=======================================================================
# 5. Real-Time Async Streaming Pipeline
#=======================================================================
async def stream_audio(text_content, selected_voice):
    MODEL_PATH = f"/home/{USER}/models/kokoro-v1.0.onnx"
    VOICES_PATH = f"/home/{USER}/models/voices-v1.0.bin"

    session_options = ort.SessionOptions()
    session_options.log_severity_level = 3

    session = ort.InferenceSession(
        MODEL_PATH,
        sess_options=session_options,
        providers=["CUDAExecutionProvider", "CPUExecutionProvider"]
    )

    kokoro = Kokoro.from_session(session, VOICES_PATH)

    # Initialize a clean background ffplay process consuming raw float32 streams
    # -nodisp disables the pop-up window; -autoexit closes the thread upon text end
    ffplay_cmd = [
        "ffplay", "-nodisp", "-autoexit", 
        "-f", "f32le", "-ar", "24000", "-ac", "1", "-"
    ]
    
    player = subprocess.Popen(
        ffplay_cmd, 
        stdin=subprocess.PIPE, 
        stdout=subprocess.DEVNULL, 
        stderr=subprocess.DEVNULL
    )

    # Instantiate the iterator streaming engine across chunks
    stream = kokoro.create_stream(
        text_content,
        voice=selected_voice,
        speed=1.0,
        lang="en-us"
    )

    print("Streaming audio playback initiated...")
    
    async for samples, sample_rate in stream:
        if player.poll() is not None:
            break  # Player was closed or terminated early
        # Convert audio numpy floats straight to binary bits and push to PulseAudio
        player.stdin.write(samples.tobytes())
        player.stdin.flush()

    # Clean up and close the pipeline handles
    if player.stdin:
        player.stdin.close()
    player.wait()
    print("Playback complete.")

def main():
    input_path, selected_voice = parse_arguments()

    try:
        with open(input_path, "r", encoding="utf-8") as f:
            text_content = f.read().strip()
    except Exception as e:
        print(f"Error reading input file: {e}")
        sys.exit(1)

    if not text_content:
        print("Error: Input text file is empty.")
        sys.exit(1)

    # Run the streaming loop inside Python's async core
    asyncio.run(stream_audio(text_content, selected_voice))

if __name__ == "__main__":
    main()