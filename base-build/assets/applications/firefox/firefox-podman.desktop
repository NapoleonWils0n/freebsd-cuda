[Desktop Entry]
Version=1.0
Name=Firefox-podman
Comment=Browse the World Wide Web
GenericName=Web Browser
Keywords=Internet;WWW;Browser;Web;Explorer
Exec=sh -c "wrapper-freebsd -j firefox -a firefox -c "${HOME}/podman/freebsd-cuda/containers/browsers/firefox/compose.yaml" -e "${HOME}/podman/freebsd-cuda/containers/browsers/firefox/.env" %U"
Terminal=false
Type=Application
Icon=firefox
Categories=GNOME;GTK;Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;application/xml;application/rss+xml;application/rdf+xml;image/gif;image/jpeg;image/png;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/ftp;x-scheme-handler/chrome;video/webm;application/x-xpinstall;
StartupNotify=true
Actions=NewWindow;NewPrivateWindow;

[Desktop Action NewWindow]
Name=Open a New Window
Exec=sh -c "wrapper-freebsd -j firefox -a firefox -c "${HOME}/podman/freebsd-cuda/containers/browsers/firefox/compose.yaml" -e "${HOME}/podman/freebsd-cuda/containers/browsers/firefox/.env" -new-window %U"

[Desktop Action NewPrivateWindow]
Name=Open a New Private Window
Exec=sh -c "wrapper-freebsd -j firefox -a firefox -c "${HOME}/podman/freebsd-cuda/containers/browsers/firefox/compose.yaml" -e "${HOME}/podman/freebsd-cuda/containers/browsers/firefox/.env" -private-window %U"